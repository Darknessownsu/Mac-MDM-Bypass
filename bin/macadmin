#!/bin/bash
set -u
PATH=/usr/bin:/bin:/usr/sbin:/sbin
LC_ALL=C
export PATH LC_ALL
version=2.0.0-alpha.2
usage() {
  printf '%s\n' 'MacAdmin Toolkit — read-only diagnostics' 'Usage: bash bin/macadmin [status|security|enrollment|all|--help|--version]' 'No system settings are modified.'
}
if [ "$#" -gt 1 ]; then usage >&2; exit 2; fi
case "${1:---help}" in
  --help|-h) usage; exit 0 ;;
  --version) printf '%s\n' "$version"; exit 0 ;;
  status|security|enrollment|all) ;;
  *) usage >&2; exit 2 ;;
esac
if [ "$(uname -s)" != Darwin ]; then
  printf '%s\n' 'Diagnostics require macOS.' >&2
  exit 3
fi
root="$(cd "$(dirname "$0")/.." && pwd)" || exit 1
. "$root/lib/core.sh" || exit 1
. "$root/lib/diagnostics.sh" || exit 1
case "$1" in
  status) diagnose_status ;;
  security) diagnose_security ;;
  enrollment) diagnose_enrollment ;;
  all) diagnose_all ;;
esac
